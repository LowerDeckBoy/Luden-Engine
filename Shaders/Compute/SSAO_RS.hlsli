		"filter = FILTER_MIN_MAG_MIP_LINEAR ),"\
	"StaticSampler(s1, "\
		"addressU = TEXTURE_ADDRESS_MIRROR, "\
		"addressV = TEXTURE_ADDRESS_MIRROR, "\
		"filter = FILTER_MIN_MAG_MIP_LINEAR )"

